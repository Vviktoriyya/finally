{
  "name": "booksshop",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "tw": "tailwindcss -i ./input.css -o ./output.css --watch --content ./index.html ./book.html ./modal.html ./**/*.js",
    "serve": "live-server --host=localhost --port=5173 --open=./index.html --wait=200",
    "serve:admin": "live-server --host=localhost --port=5173 --open=./admin.html --wait=200",
    "api": "json-server --watch db.json --port 3000",
    "start": "concurrently \"npm:tw\" \"npm:serve\" \"npm:api\"",
    "start:admin": "concurrently \"npm:tw\" \"npm:serve:admin\" \"npm:api\"",
    "browserslist:update": "npx update-browserslist-db@latest",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "json-server": "^1.0.0-beta.3",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.17"
  }
}